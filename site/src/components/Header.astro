---
import ExternalLink from "./ExternalLink.astro";
import Icon from "./Icon.astro";
import { getBrand } from "../lib/content";
import { whatsappHref } from "../lib/format";
import { getNav, isActive } from "../lib/nav";
import { url } from "../lib/url";

const { contact } = await getBrand();
const nav = await getNav();
const pathname = Astro.url.pathname;
const cartActive = isActive(["/carrinho", "/checkout"], pathname);
const whatsapp = whatsappHref(contact.whatsapp, "Olá! Vim pelo site da VCV.");
---

<header class="site-header sticky top-0 z-50 border-b border-border bg-cream/90 backdrop-blur-md" data-header>
  <div class="header-bar container-page flex items-center justify-between gap-6 py-4">
    <a href={url("/")} class="flex flex-col leading-none" aria-label="VCV — Veste Com Você, página inicial">
      <span class="font-serif text-3xl tracking-tight text-wine">VCV</span>
      <span class="mt-1 text-[0.6rem] tracking-[0.32em] text-text-muted uppercase">Veste Com Você</span>
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-7">
        {
          nav.map((item, index) => {
            const active = isActive(item.match, pathname);
            const link = [
              "inline-flex min-h-11 items-center border-b-2 text-sm transition-colors duration-200",
              active ? "border-rose font-medium text-wine" : "border-transparent text-text hover:border-rose/60 hover:text-wine",
            ];
            return item.children ? (
              <li class="nav-group relative" data-nav-group>
                {/* The chevron keeps a 44px touch target; its negative margins cancel the invisible
                    padding so the visible gap after it equals the nav gap (28px). */}
                <div class="inline-flex items-center">
                  <a href={item.href} aria-current={active ? "page" : undefined} class:list={link}>{item.label}</a>
                  <button
                    type="button"
                    class="-mr-3.5 -ml-2.5 inline-flex size-11 cursor-pointer items-center justify-center rounded-md text-text-muted transition-colors hover:text-wine"
                    aria-expanded="false"
                    aria-controls={`nav-panel-${index}`}
                    aria-label={`Abrir submenu de ${item.label}`}
                    data-nav-toggle
                  >
                    <Icon name="chevron-down" size={16} class="nav-chevron" />
                  </button>
                </div>
                <div id={`nav-panel-${index}`} class="nav-panel absolute top-full left-0 z-50 pt-3" data-nav-panel>
                  <ul class="min-w-56 rounded-lg border border-border bg-cream py-2 shadow-[var(--shadow-card)]">
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href} class="flex min-h-11 items-center px-5 text-sm text-text transition-colors hover:bg-nude hover:text-wine">{child.label}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ) : (
              <li>
                <a href={item.href} aria-current={active ? "page" : undefined} class:list={link}>{item.label}</a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1 sm:gap-2">
      <a
        href={url("/busca/")}
        class="inline-flex size-11 items-center justify-center rounded-md text-text transition-colors duration-200 hover:text-wine"
        aria-label="Buscar peças"
        aria-current={isActive(["/busca"], pathname) ? "page" : undefined}
      >
        <Icon name="search" size={21} />
      </a>
      <a
        href={url("/carrinho/")}
        class:list={[
          "relative inline-flex min-h-11 items-center gap-2 rounded-md px-3 text-sm transition-colors duration-200 hover:text-wine",
          cartActive ? "font-medium text-wine" : "text-text",
        ]}
        aria-current={cartActive ? "page" : undefined}
        data-cart-link
      >
        <Icon name="bag" size={22} />
        <span class="hidden sm:inline">Sacola</span>
        <span
          class="inline-flex min-w-5 items-center justify-center rounded-full bg-wine px-1.5 text-[0.6875rem] leading-5 font-semibold text-cream"
          data-cart-count
          hidden>0</span
        >
        <span class="sr-only" data-cart-label>(vazia)</span>
      </a>
      <ExternalLink href={whatsapp} class="btn btn-outline hidden md:inline-flex">
        <Icon name="message" size={18} />
        WhatsApp
      </ExternalLink>
      <button
        type="button"
        class="menu-toggle inline-flex size-11 items-center justify-center rounded-md border border-border text-wine transition-colors hover:border-wine lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="sr-only" data-menu-label>Abrir menu</span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="expandable lg:hidden" data-open="false" data-mobile-menu>
    <div>
      <nav aria-label="Principal (celular)" class="container-page pb-6">
        <ul class="border-t border-border">
          {
            nav.map((item, index) => {
              const active = isActive(item.match, pathname);
              const row = ["flex min-h-12 flex-1 items-center justify-between text-base", active ? "font-medium text-wine" : "text-text"];
              return (
                <li class="border-b border-border">
                  <div class="flex items-center">
                    <a href={item.href} aria-current={active ? "page" : undefined} class:list={row}>
                      {item.label}
                      {!item.children && <Icon name="arrow-right" size={16} class="text-rose-ink" />}
                    </a>
                    {item.children && (
                      <button
                        type="button"
                        class="inline-flex size-12 cursor-pointer items-center justify-center text-text-muted"
                        aria-expanded="false"
                        aria-controls={`sub-${index}`}
                        aria-label={`Abrir submenu de ${item.label}`}
                        data-sub-toggle
                      >
                        <Icon name="chevron-down" size={18} class="nav-chevron" />
                      </button>
                    )}
                  </div>
                  {item.children && (
                    <div id={`sub-${index}`} class="expandable" data-open="false" data-sub-panel>
                      <ul class="pb-2 pl-4">
                        {item.children.map((child) => (
                          <li>
                            <a href={child.href} class="flex min-h-11 items-center text-[0.9375rem] text-text-muted hover:text-wine">{child.label}</a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </li>
              );
            })
          }
        </ul>
        <ExternalLink href={whatsapp} class="btn btn-primary btn-lg mt-6 w-full">
          <Icon name="message" size={18} />
          Falar no WhatsApp
        </ExternalLink>
      </nav>
    </div>
  </div>
  <noscript><style>#mobile-menu { grid-template-rows: 1fr; opacity: 1; }</style></noscript>
</header>

<style>
  .header-bar {
    transition: padding-block 300ms var(--ease-soft);
  }
  .site-header {
    transition: box-shadow 300ms var(--ease-soft);
  }
  .site-header:global(.is-condensed) {
    box-shadow: 0 8px 24px -18px rgb(33 26 24 / 0.5);
  }
  .site-header:global(.is-condensed) .header-bar {
    padding-block: 0.5rem;
  }

  /* Desktop dropdowns: open on hover, on keyboard focus inside, or via the chevron button. Hidden
     panels are visibility:hidden so their links stay out of the tab order. */
  .nav-panel {
    visibility: hidden;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 200ms var(--ease-soft),
      transform 200ms var(--ease-soft),
      visibility 0s linear 200ms;
  }
  .nav-group:hover > .nav-panel,
  .nav-group:focus-within > .nav-panel,
  .nav-group[data-open="true"] > .nav-panel {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }
  /* Escape closes a dropdown even while the pointer or focus is still inside it. */
  .nav-group[data-dismissed="true"]:not([data-open="true"]) > .nav-panel {
    visibility: hidden;
    opacity: 0;
    transform: translateY(6px);
  }

  /* The chevron is an <Icon> (another component), so reach it with :global. */
  :global(.nav-chevron) {
    transition: transform 200ms var(--ease-soft);
  }
  .nav-group:hover :global(.nav-chevron),
  .nav-group[data-open="true"] :global(.nav-chevron),
  [aria-expanded="true"] > :global(.nav-chevron) {
    transform: rotate(180deg);
  }

  /* Hamburger → X */
  .menu-icon {
    position: relative;
    display: block;
    width: 18px;
    height: 12px;
  }
  .menu-icon span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    border-radius: 1px;
    background: currentColor;
    transition:
      transform 300ms var(--ease-soft),
      opacity 200ms ease,
      top 300ms var(--ease-soft);
  }
  .menu-icon span:nth-child(1) {
    top: 0;
  }
  .menu-icon span:nth-child(2) {
    top: 5.25px;
  }
  .menu-icon span:nth-child(3) {
    top: 10.5px;
  }
  [aria-expanded="true"] .menu-icon span:nth-child(1) {
    top: 5.25px;
    transform: rotate(45deg);
  }
  [aria-expanded="true"] .menu-icon span:nth-child(2) {
    opacity: 0;
  }
  [aria-expanded="true"] .menu-icon span:nth-child(3) {
    top: 5.25px;
    transform: rotate(-45deg);
  }
</style>

<script>
  import { itemCount, onCartChange, readCart } from "../scripts/cart";

  // Header island: condense on scroll, animated mobile menu, live bag count. The page is fully
  // navigable without this script (see the <noscript> rule above).
  const header = document.querySelector<HTMLElement>("[data-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  const label = document.querySelector<HTMLElement>("[data-menu-label]");

  if (header) {
    let condensed = false;
    const onScroll = () => {
      const next = window.scrollY > 24;
      if (next !== condensed) {
        condensed = next;
        header.classList.toggle("is-condensed", condensed);
      }
    };
    document.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      menu.dataset.open = String(open);
      menu.inert = !open; // closed menu links are out of the tab order
      if (label) label.textContent = open ? "Fechar menu" : "Abrir menu";
    };
    setOpen(false);

    toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
    menu.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) setOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    });
    // Leaving the mobile layout (rotate / resize) closes the menu.
    window.matchMedia("(min-width: 64rem)").addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }

  // Desktop dropdowns: the chevron toggles (keyboard / touch); Escape or an outside click closes.
  const groups = [...document.querySelectorAll<HTMLElement>("[data-nav-group]")];
  const closeGroups = (except?: HTMLElement) =>
    groups.forEach((group) => {
      if (group === except) return;
      group.dataset.open = "false";
      group.querySelector("[data-nav-toggle]")?.setAttribute("aria-expanded", "false");
    });
  groups.forEach((group) => {
    const toggle = group.querySelector<HTMLButtonElement>("[data-nav-toggle]")!;
    toggle.addEventListener("click", () => {
      const open = group.dataset.open !== "true";
      closeGroups(group);
      group.dataset.open = String(open);
      toggle.setAttribute("aria-expanded", String(open));
    });
  });
  document.addEventListener("click", (event) => {
    if (!(event.target as HTMLElement).closest("[data-nav-group]")) closeGroups();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const openGroup = groups.find((group) => group.dataset.open === "true" || group.matches(":hover, :focus-within"));
    if (openGroup) {
      closeGroups();
      openGroup.dataset.dismissed = "true";
      openGroup.querySelector<HTMLElement>("[data-nav-toggle]")?.focus();
    }
  });
  // A dismissed dropdown works again once the pointer or focus has left it.
  groups.forEach((group) => {
    const reset = () => delete group.dataset.dismissed;
    group.addEventListener("mouseleave", reset);
    group.addEventListener("focusout", (event) => {
      if (!group.contains(event.relatedTarget as Node | null)) reset();
    });
    group.querySelector("[data-nav-toggle]")?.addEventListener("click", reset);
  });

  // Mobile menu: each group expands like an accordion (animated, closed panels are inert).
  document.querySelectorAll<HTMLButtonElement>("[data-sub-toggle]").forEach((button) => {
    const panel = document.getElementById(button.getAttribute("aria-controls")!)!;
    panel.inert = true;
    button.addEventListener("click", () => {
      const open = button.getAttribute("aria-expanded") !== "true";
      button.setAttribute("aria-expanded", String(open));
      panel.dataset.open = String(open);
      panel.inert = !open;
    });
  });

  const badge = document.querySelector<HTMLElement>("[data-cart-count]");
  const cartLabel = document.querySelector<HTMLElement>("[data-cart-label]");
  if (badge) {
    let last = itemCount(readCart());
    const render = () => {
      const count = itemCount(readCart());
      badge.hidden = count === 0;
      badge.textContent = String(count);
      if (cartLabel) cartLabel.textContent = count === 0 ? "(vazia)" : `(${count} ${count === 1 ? "item" : "itens"})`;
      if (count > last) {
        badge.classList.remove("is-bumped");
        void badge.offsetWidth; // restart the animation
        badge.classList.add("is-bumped");
      }
      last = count;
    };
    render();
    onCartChange(render);
  }
</script>
