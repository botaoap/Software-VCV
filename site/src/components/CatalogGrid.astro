---
import type { CollectionEntry } from "astro:content";
import ProductCard from "./ProductCard.astro";
import { audienceLabels, sortSizes } from "../lib/catalog";

// Product grid + sort/filter controls. The server renders every product in content order ("Relevância"),
// so the page is complete without JS; the island then sorts/filters in place and mirrors the choice
// in the URL (?ordem=&para=&tam=) so a filtered view can be shared. Each filter appears only
// when it can narrow the list (e.g. "Para" once both feminine and masculine pieces are on sale).
interface Props {
  products: CollectionEntry<"products">[];
  label: string;
}
const { products, label } = Astro.props;
const sizes = sortSizes(products.flatMap((product) => product.data.sizes));
const audiences = (Object.keys(audienceLabels) as (keyof typeof audienceLabels)[]).filter((audience) =>
  products.some((product) => product.data.audience === audience),
);
---

<div data-catalog>
  <div class="js-only grid grid-cols-2 items-end gap-x-4 gap-y-4 border-y border-border py-4 sm:flex sm:flex-wrap sm:gap-x-6">
    <div>
      <label for="catalog-sort" class="text-xs font-medium tracking-[0.18em] text-text-muted uppercase">Ordenar por</label>
      <select id="catalog-sort" class="field w-full sm:w-auto sm:min-w-44 !mt-1" data-sort>
        <option value="relevancia">Relevância</option>
        <option value="menor-preco">Menor preço</option>
        <option value="maior-preco">Maior preço</option>
        <option value="nome">Nome A–Z</option>
      </select>
    </div>
    {
      audiences.length > 1 && (
        <div>
          <label for="catalog-audience" class="text-xs font-medium tracking-[0.18em] text-text-muted uppercase">Para</label>
          <select id="catalog-audience" class="field w-full sm:w-auto sm:min-w-36 !mt-1" data-filter-audience>
            <option value="">Todos</option>
            {audiences.map((audience) => <option value={audience}>{audienceLabels[audience]}</option>)}
          </select>
        </div>
      )
    }
    {
      sizes.length > 1 && (
        <div>
          <label for="catalog-size" class="text-xs font-medium tracking-[0.18em] text-text-muted uppercase">Tamanho</label>
          <select id="catalog-size" class="field w-full sm:w-auto sm:min-w-32 !mt-1" data-filter-size>
            <option value="">Todos</option>
            {sizes.map((size) => <option value={size}>{size}</option>)}
          </select>
        </div>
      )
    }
    <p class="col-span-2 text-sm text-text-muted sm:ml-auto" aria-live="polite" data-count></p>
  </div>

  <ul class="mt-8 grid grid-cols-2 gap-x-4 gap-y-10 md:gap-x-6 lg:grid-cols-4" aria-label={label} data-grid>
    {products.map((product, index) => <ProductCard product={product} index={index} priority={index < 4} heading="h2" />)}
  </ul>

  <div class="mt-10 hidden text-center" data-empty>
    <p class="text-lg text-text-muted">Nenhuma peça com esses filtros.</p>
    <button type="button" class="btn btn-outline mt-4" data-reset>Limpar filtros</button>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-catalog]");
  if (root) {
    const grid = root.querySelector<HTMLElement>("[data-grid]")!;
    const cards = [...grid.querySelectorAll<HTMLElement>("[data-product-card]")];
    const sort = root.querySelector<HTMLSelectElement>("[data-sort]")!;
    const audience = root.querySelector<HTMLSelectElement>("[data-filter-audience]");
    const size = root.querySelector<HTMLSelectElement>("[data-filter-size]");
    const count = root.querySelector<HTMLElement>("[data-count]")!;
    const empty = root.querySelector<HTMLElement>("[data-empty]")!;

    const sorters: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
      relevancia: (a, b) => Number(a.dataset.index) - Number(b.dataset.index),
      "menor-preco": (a, b) => Number(a.dataset.price) - Number(b.dataset.price),
      "maior-preco": (a, b) => Number(b.dataset.price) - Number(a.dataset.price),
      nome: (a, b) => (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "", "pt-BR"),
    };

    const params = new URLSearchParams(location.search);
    const set = (select: HTMLSelectElement | null, value: string | null) => {
      if (select && value && [...select.options].some((o) => o.value === value)) select.value = value;
    };
    set(sort, params.get("ordem"));
    set(audience, params.get("para"));
    set(size, params.get("tam"));

    const render = () => {
      const ordered = [...cards].sort(sorters[sort.value] ?? sorters.relevancia);
      ordered.forEach((card, position) => (card.style.order = String(position)));
      let visible = 0;
      for (const card of cards) {
        const matches =
          (!audience?.value || card.dataset.audience === audience.value) &&
          (!size?.value || (card.dataset.sizes ?? "").split(",").includes(size.value));
        card.hidden = !matches;
        if (matches) visible++;
      }
      count.textContent = `${visible} ${visible === 1 ? "peça" : "peças"}`;
      empty.classList.toggle("hidden", visible > 0);

      const next = new URLSearchParams();
      if (sort.value !== "relevancia") next.set("ordem", sort.value);
      if (audience?.value) next.set("para", audience.value);
      if (size?.value) next.set("tam", size.value);
      const query = next.toString();
      history.replaceState(null, "", `${location.pathname}${query ? `?${query}` : ""}`);
    };

    [sort, audience, size].forEach((select) => select?.addEventListener("change", render));
    root.querySelector("[data-reset]")?.addEventListener("click", () => {
      sort.value = "relevancia";
      if (audience) audience.value = "";
      if (size) size.value = "";
      render();
    });
    render();
  }
</script>
