---
import ExternalLink from "./ExternalLink.astro";
import Icon from "./Icon.astro";
import { getBrand } from "../lib/content";
import { whatsappHref } from "../lib/format";

const { contact } = await getBrand();
---

<ExternalLink
  href={whatsappHref(contact.whatsapp, "Olá! Vim pelo site da VCV.")}
  class="fixed right-4 bottom-4 z-40 inline-flex min-h-12 items-center gap-2 rounded-full bg-wine px-3.5 text-sm sm:px-5 font-medium text-cream shadow-[var(--shadow-button)] transition-[background-color,transform] duration-200 hover:bg-wine-deep motion-safe:hover:-translate-y-0.5 sm:right-6 sm:bottom-6"
>
  <Icon name="message" size={20} />
  <span class="sr-only sm:not-sr-only">Fale no WhatsApp</span>
</ExternalLink>
