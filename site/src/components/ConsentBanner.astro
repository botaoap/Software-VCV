---
// LGPD cookie consent. Nothing but strictly necessary storage runs until the visitor decides;
// Google Analytics loads ONLY after the analytics category is accepted. "Aceitar" and "Rejeitar"
// have equal visual weight (filled vs. full outline) on purpose: no dark patterns.
// Starts hidden (native [hidden]); the script decides whether to show it.
// Rendered only when PUBLIC_GA_ID is set (src/lib/services.ts): with nothing to consent to, there is no banner.
import { url } from "../lib/url";
---

<div id="consent" class="consent fixed inset-0 z-[60] flex items-end justify-center sm:items-center sm:p-6" hidden data-consent>
  <div class="consent-backdrop absolute inset-0 bg-ink/55"></div>
  <div
    class="consent-card relative w-full max-w-lg rounded-t-xl border border-border bg-paper p-6 shadow-[var(--shadow-modal)] sm:rounded-xl sm:p-8"
    role="dialog"
    aria-modal="true"
    aria-labelledby="consent-title"
    aria-describedby="consent-desc"
  >
    <h2 id="consent-title" class="text-2xl">Privacidade e cookies</h2>
    <p id="consent-desc" class="mt-3 text-sm leading-relaxed text-text-muted">
      Usamos cookies necessários para o site funcionar e, só com a sua permissão, cookies de análise para entender
      como o site é usado. Nenhum script de análise é carregado antes da sua escolha.
    </p>
    <p class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm">
      <a href={url("/privacidade/")} class="text-link inline-flex min-h-11 items-center">Privacidade</a>
      <a href={url("/cookies/")} class="text-link inline-flex min-h-11 items-center">Cookies</a>
      <a href={url("/termos/")} class="text-link inline-flex min-h-11 items-center">Termos</a>
    </p>

    <div id="consent-options" class="expandable" data-open="false" data-consent-options>
      <div>
        <fieldset class="mt-4 space-y-1 rounded-lg border border-border p-4">
          <legend class="px-1 text-sm font-medium text-wine">Categorias</legend>
          <label class="flex min-h-11 items-center gap-3 text-sm text-text-muted">
            <input type="checkbox" checked disabled class="size-4 accent-[var(--color-wine)]" />
            Necessários (sempre ativos)
          </label>
          <label class="flex min-h-11 items-center gap-3 text-sm">
            <input type="checkbox" data-category="analytics" class="size-4 accent-[var(--color-wine)]" />
            Análise (Google Analytics)
          </label>
          <label class="flex min-h-11 items-center gap-3 text-sm">
            <input type="checkbox" data-category="marketing" class="size-4 accent-[var(--color-wine)]" />
            Marketing
          </label>
          <button type="button" class="btn btn-primary mt-2 w-full" data-consent-save>Salvar preferências</button>
        </fieldset>
      </div>
    </div>

    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <button type="button" class="btn btn-primary btn-lg flex-1" data-consent-accept>Aceitar</button>
      <button type="button" class="btn btn-outline btn-lg flex-1" data-consent-reject>Rejeitar</button>
    </div>
    <button
      type="button"
      class="mt-3 inline-flex min-h-11 cursor-pointer items-center text-sm text-text-muted underline underline-offset-4 hover:text-wine"
      aria-expanded="false"
      aria-controls="consent-options"
      data-consent-customize
    >
      Personalizar
    </button>
    <p class="sr-only" aria-live="polite" data-consent-announce></p>
  </div>
</div>

<style>
  .consent:not([hidden]) .consent-backdrop {
    animation: consent-fade 250ms ease-out;
  }
  .consent:not([hidden]) .consent-card {
    animation: consent-rise 350ms var(--ease-soft);
  }
  @keyframes consent-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes consent-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
</style>

<script>
  import { services } from "../lib/services";

  type Categories = { necessary: true; analytics: boolean; marketing: boolean };
  type ConsentState = { decided: boolean; categories: Categories };

  const STORAGE_KEY = "vcv-consent";
  const GA_MEASUREMENT_ID = services.gaMeasurementId;

  function load(): ConsentState {
    const fallback: ConsentState = { decided: false, categories: { necessary: true, analytics: false, marketing: false } };
    try {
      const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "null");
      if (!parsed) return fallback;
      return {
        decided: Boolean(parsed.decided),
        categories: {
          necessary: true,
          analytics: Boolean(parsed.categories?.analytics),
          marketing: Boolean(parsed.categories?.marketing),
        },
      };
    } catch {
      return fallback;
    }
  }

  function save(state: ConsentState) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    } catch {
      // Storage blocked (private mode): the banner simply shows again next visit.
    }
  }

  function loadAnalytics() {
    if (GA_MEASUREMENT_ID.includes("XXXX") || document.getElementById("ga-script")) return;
    const script = document.createElement("script");
    script.id = "ga-script";
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`;
    document.head.appendChild(script);
    const w = window as unknown as { dataLayer: unknown[] };
    w.dataLayer = w.dataLayer || [];
    w.dataLayer.push(["js", new Date()], ["config", GA_MEASUREMENT_ID, { anonymize_ip: true }]);
  }

  const root = document.querySelector<HTMLElement>("[data-consent]");
  if (root) {
    const card = root.querySelector<HTMLElement>("[role=dialog]")!;
    const accept = root.querySelector<HTMLButtonElement>("[data-consent-accept]")!;
    const reject = root.querySelector<HTMLButtonElement>("[data-consent-reject]")!;
    const customize = root.querySelector<HTMLButtonElement>("[data-consent-customize]")!;
    const options = root.querySelector<HTMLElement>("[data-consent-options]")!;
    const saveButton = root.querySelector<HTMLButtonElement>("[data-consent-save]")!;
    const announce = root.querySelector<HTMLElement>("[data-consent-announce]")!;
    const checkbox = (name: string) => root.querySelector<HTMLInputElement>(`[data-category=${name}]`)!;
    let returnFocus: HTMLElement | null = null;

    const setOptionsOpen = (open: boolean) => {
      options.dataset.open = String(open);
      options.inert = !open;
      customize.setAttribute("aria-expanded", String(open));
    };

    // Focus stays inside the dialog while it's open. No Escape / backdrop dismiss: an explicit
    // choice is required.
    const trapFocus = (event: KeyboardEvent) => {
      if (event.key !== "Tab") return;
      const focusable = [...card.querySelectorAll<HTMLElement>("a[href], button, input:not([disabled])")].filter(
        (el) => !el.closest("[inert]"),
      );
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    };

    const show = (open: boolean) => {
      root.hidden = !open;
      if (open) {
        returnFocus = document.activeElement as HTMLElement | null;
        const current = load().categories;
        checkbox("analytics").checked = current.analytics;
        checkbox("marketing").checked = current.marketing;
        setOptionsOpen(false);
        accept.focus();
        document.addEventListener("keydown", trapFocus);
      } else {
        document.removeEventListener("keydown", trapFocus);
        returnFocus?.focus();
      }
    };

    const decide = (categories: Categories, message: string) => {
      save({ decided: true, categories });
      if (categories.analytics) loadAnalytics();
      announce.textContent = message;
      show(false);
    };

    accept.addEventListener("click", () =>
      decide({ necessary: true, analytics: true, marketing: true }, "Preferências salvas: todos os cookies aceitos."),
    );
    reject.addEventListener("click", () =>
      decide({ necessary: true, analytics: false, marketing: false }, "Preferências salvas: apenas cookies necessários."),
    );
    customize.addEventListener("click", () => setOptionsOpen(options.dataset.open !== "true"));
    saveButton.addEventListener("click", () =>
      decide(
        { necessary: true, analytics: checkbox("analytics").checked, marketing: checkbox("marketing").checked },
        "Preferências de cookies salvas.",
      ),
    );
    document.querySelectorAll("[data-open-consent]").forEach((button) =>
      button.addEventListener("click", () => show(true)),
    );

    const state = load();
    if (state.categories.analytics) loadAnalytics();
    if (!state.decided) show(true);
  }
</script>
