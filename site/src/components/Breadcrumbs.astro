---
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Você está em" class="text-sm text-text-muted">
  <ol class="flex flex-wrap items-center gap-x-2">
    {
      items.map((item, index) => (
        <li class="flex items-center gap-x-2">
          {item.href ? <a href={item.href} class="inline-flex min-h-11 items-center hover:text-wine hover:underline">{item.label}</a> : <span aria-current="page">{item.label}</span>}
          {index < items.length - 1 && <span aria-hidden="true">/</span>}
        </li>
      ))
    }
  </ol>
</nav>
