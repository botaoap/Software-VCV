---
// The anatomy every section repeats: eyebrow → serif H2 → optional lede → (slot: right-aligned action).
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  id?: string;
  level?: 1 | 2;
  class?: string;
}
const { eyebrow, title, lede, id, level = 2, class: className } = Astro.props;
const Tag = level === 1 ? "h1" : "h2";
---

<div class:list={["flex flex-wrap items-end justify-between gap-x-8 gap-y-3", className]}>
  <div class="max-w-2xl">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <Tag id={id} class:list={["mt-3", level === 1 ? "text-4xl md:text-5xl" : "text-3xl md:text-4xl"]}>{title}</Tag>
    {lede && <p class="mt-4 text-lg leading-relaxed text-text-muted">{lede}</p>}
  </div>
  <slot />
</div>
