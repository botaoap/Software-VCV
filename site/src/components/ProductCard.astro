---
import type { CollectionEntry } from "astro:content";
import Photo from "./Photo.astro";
import { badgeLabels, formatBrl } from "../lib/format";
import { url } from "../lib/url";

// A product tile: the whole tile is one link. Photo (fixed 3:4, no layout shift) with a subtle hover
// zoom, marketing badge, name, price. data-* attributes feed the catalog filter/sort island.
interface Props {
  product: CollectionEntry<"products">;
  /** Position in content order, so the catalog island can restore "Novidades". */
  index?: number;
  priority?: boolean;
  /** Heading level for the product name: h3 under a section title, h2 on listing pages. */
  heading?: "h2" | "h3";
  class?: string;
}
const { product, index = 0, priority = false, heading: Heading = "h3", class: className } = Astro.props;
const { data } = product;
const cover = data.images[0];
const badge = data.badges[0];
---

<li
  class={className}
  data-product-card
  data-index={index}
  data-name={data.name.toLowerCase()}
  data-price={data.priceCents}
  data-collection={data.collection.id}
  data-sizes={data.sizes.join(",")}
>
  <a href={url(`/produto/${product.id}/`)} class="group block">
    <div class="media aspect-[3/4] rounded-sm">
      <Photo
        src={cover.url}
        alt=""
        width={cover.width}
        height={cover.height}
        widths={[320, 480, 640, 800]}
        sizes="(min-width: 1024px) 22vw, (min-width: 640px) 30vw, 46vw"
        priority={priority}
      />
      {badge && (
        <span class:list={["badge absolute top-3 left-3", badge === "LAST_UNITS" && "badge-alert"]}>{badgeLabels[badge]}</span>
      )}
    </div>
    <Heading class="mt-3 font-sans text-base leading-snug font-medium text-text group-hover:underline group-hover:decoration-rose group-hover:underline-offset-4">
      {data.name}
    </Heading>
    <p class="mt-1 text-base font-medium text-wine">{formatBrl(data.priceCents)}</p>
  </a>
</li>
