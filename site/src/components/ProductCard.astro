---
import type { Product } from "../lib/commerce/port";
import Photo from "./Photo.astro";
import { coverOf } from "../lib/catalog";
import { badgeLabels, formatBrl, labelOf } from "../lib/format";
import { url } from "../lib/url";

// A product tile: the whole tile is one link. Photo (fixed 3:4, no layout shift) with a subtle hover
// zoom, marketing badge, name, price and the color swatches (marketplace pattern). data-* attributes
// feed the catalog filter/sort island.
interface Props {
  product: Product;
  /** Position in content order, so the catalog island can restore "Relevância". */
  index?: number;
  priority?: boolean;
  /** Heading level for the product name: h3 under a section title, h2 on listing pages. */
  heading?: "h2" | "h3";
  /** Lower-cased, accent-free text the search page matches against. */
  search?: string;
  class?: string;
}
const { product, index = 0, priority = false, heading: Heading = "h3", search, class: className } = Astro.props;
const cover = coverOf(product);
const badge = labelOf(product.badges);
const MAX_SWATCHES = 5;
---

<li
  class={className}
  data-product-card
  data-index={index}
  data-name={product.name.toLowerCase()}
  data-search={search}
  data-price={product.priceCents}
  data-category={product.categoryId}
  data-audience={product.audience}
  data-sizes={product.sizes.join(",")}
>
  <a href={url(`/produto/${product.id}/`)} class="group block">
    <div class="media aspect-[3/4] rounded-sm">
      <Photo
        src={cover.url}
        alt=""
        width={cover.width}
        height={cover.height}
        widths={[320, 480, 640, 800]}
        sizes="(min-width: 1024px) 22vw, (min-width: 640px) 30vw, 46vw"
        priority={priority}
      />
      {badge && (
        <span class:list={["badge absolute top-3 left-3", badge === "LAST_UNITS" && "badge-alert"]}>{badgeLabels[badge]}</span>
      )}
    </div>
    <Heading class="mt-3 font-sans text-base leading-snug font-medium text-text group-hover:underline group-hover:decoration-rose group-hover:underline-offset-4">
      {product.name}
    </Heading>
    <p class="mt-1 text-base font-medium text-wine">{formatBrl(product.priceCents)}</p>
    {
      product.colors.length > 1 && (
        <p class="mt-2 flex items-center gap-1.5">
          {product.colors.slice(0, MAX_SWATCHES).map((color) => (
            <span class="swatch swatch-sm" style={`--swatch: ${color.hex}`} aria-hidden="true" />
          ))}
          <span class="ml-1 text-xs text-text-muted">{product.colors.length} cores</span>
        </p>
      )
    }
  </a>
</li>
