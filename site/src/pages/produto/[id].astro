---
import { getImage } from "astro:assets";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Icon from "../../components/Icon.astro";
import Photo from "../../components/Photo.astro";
import ProductCard from "../../components/ProductCard.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCategoryOf, getCollectionOf, getProducts } from "../../lib/content";
import { badgeLabels, formatBrl } from "../../lib/format";
import { brand } from "../../lib/site";
import { url } from "../../lib/url";

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({ params: { id: product.id }, props: { product } }));
}

const { product } = Astro.props;
const { data } = product;
const collection = await getCollectionOf(product);
const category = await getCategoryOf(product);
const all = await getProducts();
const related = [
  ...all.filter((p) => p.id !== product.id && p.data.collection.id === data.collection.id),
  ...all.filter((p) => p.id !== product.id && p.data.collection.id !== data.collection.id),
].slice(0, 4);

const cover = data.images[0];
// Optimised, self-hosted thumbnail stored with each bag line, and the link-preview image.
const thumb = await getImage({ src: cover.url, width: 160, height: 213, format: "webp", inferSize: false });
const og = await getImage({ src: cover.url, width: 1200, height: 630, fit: "contain", background: "#F6F0EA", format: "jpg", inferSize: false });

const pageUrl = new URL(Astro.url.pathname, Astro.site!).href;
const productLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: data.name,
  description: data.shortDescription,
  image: [new URL(og.src, Astro.site!).href],
  material: data.fabric.material,
  brand: { "@type": "Brand", name: brand.name },
  offers: {
    "@type": "Offer",
    url: pageUrl,
    priceCurrency: "BRL",
    price: (data.priceCents / 100).toFixed(2),
    availability: "https://schema.org/InStock",
  },
};
const crumbsLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { name: "Início", item: new URL(url("/"), Astro.site!).href },
    { name: "Produto", item: new URL(url("/produtos/"), Astro.site!).href },
    { name: category.data.title, item: new URL(url(`/produtos/${category.id}/`), Astro.site!).href },
    { name: data.name, item: pageUrl },
  ].map((entry, index) => ({ "@type": "ListItem", position: index + 1, ...entry })),
};

---

<BaseLayout
  title={data.name}
  description={`${data.shortDescription} ${data.fabric.material}, feito em ${data.fabric.origin}.`}
  ogType="product"
  ogImage={og.src}
  structuredData={[productLd, crumbsLd]}
>
  <div class="container-page pt-6 pb-4">
    <Breadcrumbs
      items={[
        { label: "Início", href: url("/") },
        { label: "Produto", href: url("/produtos/") },
        { label: category.data.title, href: url(`/produtos/${category.id}/`) },
        { label: data.name },
      ]}
    />
  </div>

  <section class="container-page grid gap-10 pb-16 lg:grid-cols-2 lg:gap-16" aria-labelledby="product-title">
    <!-- Gallery: a CSS scroll-snap strip (swipe on touch, works without JS); thumbnails jump to a slide. -->
    <div class="lg:sticky lg:top-28 lg:self-start" data-gallery>
      <ul class="gallery-track media flex snap-x snap-mandatory overflow-x-auto rounded-lg" data-gallery-track>
        {
          data.images.map((image, index) => (
            <li id={`foto-${index + 1}`} class="aspect-[3/4] w-full shrink-0 snap-center" data-gallery-slide>
              <Photo
                src={image.url}
                alt={image.alt}
                width={image.width}
                height={image.height}
                widths={[480, 720, 960, 1200]}
                sizes="(min-width: 1024px) 46vw, 100vw"
                priority={index === 0}
                class="size-full object-cover"
              />
            </li>
          ))
        }
      </ul>
      {
        data.images.length > 1 && (
          <ul class="mt-3 flex gap-3" aria-label="Fotos da peça">
            {data.images.map((image, index) => (
              <li>
                <a
                  href={`#foto-${index + 1}`}
                  class="media block aspect-[3/4] w-16 rounded-md border-2 border-transparent opacity-70 transition-opacity hover:opacity-100 aria-[current=true]:border-wine aria-[current=true]:opacity-100"
                  aria-label={`Ver foto ${index + 1}: ${image.alt}`}
                  aria-current={index === 0 ? "true" : undefined}
                  data-gallery-thumb={index}
                >
                  <Photo src={image.url} alt="" width={image.width} height={image.height} widths={[120, 160]} sizes="64px" />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div>
      {data.badges[0] && <p class="mb-3"><span class:list={["badge", data.badges[0] === "LAST_UNITS" && "badge-alert"]}>{badgeLabels[data.badges[0]]}</span></p>}
      <p class="eyebrow">{collection?.data.title}</p>
      <h1 id="product-title" class="mt-3 text-4xl md:text-5xl">{data.name}</h1>
      <p class="mt-4 font-sans text-2xl font-medium text-wine">{formatBrl(data.priceCents)}</p>
      <p class="mt-5 text-lg leading-relaxed text-text-muted">{data.shortDescription}</p>

      <form
        class="js-only mt-8"
        data-add-form
        data-product-id={product.id}
        data-name={data.name}
        data-price={data.priceCents}
        data-image={thumb.src}
        novalidate
      >
        <fieldset>
          <legend class="text-xs font-medium tracking-[0.18em] text-text-muted uppercase">Tamanhos</legend>
          <div class="mt-3 flex flex-wrap gap-2" role="radiogroup">
            {
              data.sizes.map((size) => (
                <label class="relative">
                  <input type="radio" name="size" value={size} class="absolute inset-0 size-full cursor-pointer opacity-0" />
                  <span class="size-pill">{size}</span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <button type="submit" class="btn btn-primary btn-lg mt-6 w-full" data-add-button disabled>
          <Icon name="bag" size={18} />
          <span data-add-label>Adicionar à sacola</span>
        </button>
        <p class="mt-3 text-sm text-text-muted" data-add-hint aria-live="polite">Selecione um tamanho.</p>
        <p class="mt-3 hidden" data-added-actions>
          <a href={url("/carrinho/")} class="link-arrow">Ver sacola <span class="arrow" aria-hidden="true">→</span></a>
        </p>
      </form>

      <noscript>
        <p class="mt-8 rounded-lg border border-border bg-paper p-4 text-sm text-text-muted">A sacola precisa de JavaScript para funcionar.</p>
      </noscript>


      <section class="mt-10 border-t border-border pt-8" aria-labelledby="spec-title">
        <h2 id="spec-title" class="text-2xl">Ficha técnica</h2>
        <dl class="mt-5 grid grid-cols-[7rem_1fr] gap-x-4 gap-y-3 text-sm">
          <dt class="text-text-muted">Material</dt>
          <dd>{data.fabric.material}</dd>
          <dt class="text-text-muted">Origem</dt>
          <dd>{data.fabric.origin}</dd>
          {data.fabric.care.length > 0 && (<><dt class="text-text-muted">Cuidados</dt><dd>{data.fabric.care.join(" · ")}</dd></>)}
          {data.fabric.notes && (<><dt class="text-text-muted">Notas</dt><dd>{data.fabric.notes}</dd></>)}
        </dl>
      </section>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="bg-paper section-y" aria-labelledby="related-title">
        <div class="container-page">
          <SectionHeading eyebrow="Combine com" title="Outras peças" id="related-title" />
          <ul class="mt-10 grid grid-cols-2 gap-x-4 gap-y-10 md:gap-x-6 lg:grid-cols-4">
            {related.map((p, index) => <ProductCard product={p} index={index} class="reveal" />)}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .gallery-track {
    scrollbar-width: none;
  }
  .gallery-track::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  import { addToCart } from "../../scripts/cart";

  // Gallery thumbnails scroll the strip (no page jump); the active thumb follows the strip.
  const track = document.querySelector<HTMLElement>("[data-gallery-track]");
  const thumbs = [...document.querySelectorAll<HTMLAnchorElement>("[data-gallery-thumb]")];
  if (track && thumbs.length > 0) {
    thumbs.forEach((thumb, index) =>
      thumb.addEventListener("click", (event) => {
        event.preventDefault();
        track.scrollTo({ left: index * track.clientWidth, behavior: "smooth" });
      }),
    );
    track.addEventListener(
      "scroll",
      () => {
        const active = Math.round(track.scrollLeft / track.clientWidth);
        thumbs.forEach((thumb, index) => (index === active ? thumb.setAttribute("aria-current", "true") : thumb.removeAttribute("aria-current")));
      },
      { passive: true },
    );
  }

  const form = document.querySelector<HTMLFormElement>("[data-add-form]");
  if (form) {
    const button = form.querySelector<HTMLButtonElement>("[data-add-button]")!;
    const label = form.querySelector<HTMLElement>("[data-add-label]")!;
    const hint = form.querySelector<HTMLElement>("[data-add-hint]")!;
    const actions = form.querySelector<HTMLElement>("[data-added-actions]")!;
    const selected = () => form.querySelector<HTMLInputElement>("input[name=size]:checked");
    let resetTimer: number | undefined;

    const reset = () => {
      label.textContent = "Adicionar à sacola";
      button.dataset.added = "false";
    };

    form.addEventListener("change", () => {
      button.disabled = !selected();
      hint.textContent = selected() ? "" : "Selecione um tamanho.";
      window.clearTimeout(resetTimer);
      reset();
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const size = selected();
      if (!size) {
        hint.textContent = "Selecione um tamanho.";
        return;
      }
      addToCart({
        productId: form.dataset.productId!,
        name: form.dataset.name!,
        image: form.dataset.image ?? null,
        unitPriceCents: Number(form.dataset.price),
        size: Number(size.value),
      });
      label.textContent = "Adicionado à sacola ✓";
      hint.textContent = `${form.dataset.name} (tamanho ${size.value}) foi adicionado à sacola.`;
      actions.classList.remove("hidden");
      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(reset, 2500);
    });
  }
</script>
