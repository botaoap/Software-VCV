---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CatalogGrid from "../../components/CatalogGrid.astro";
import PageHeader from "../../components/PageHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProductsOfCategory, getStockedCategories } from "../../lib/content";
import { url } from "../../lib/url";

// One page per garment type of the "Produtos" menu (Vestidos, Calças, …) that has products: an empty
// listing is a thin page for search engines and a dead end for visitors.
export async function getStaticPaths() {
  const categories = await getStockedCategories();
  return categories.map((category) => ({ params: { categoria: category.id }, props: { category } }));
}

const { category } = Astro.props;
const products = await getProductsOfCategory(category.id);
---

<BaseLayout
  title={category.data.title}
  description={`${category.data.title} da VCV — Veste Com Você, marca de Gaspar (SC). Veja cores, tamanhos e medidas; envio para todo o Brasil.`}
>
  <PageHeader eyebrow="Produtos" title={category.data.title}>
    <Breadcrumbs
      slot="breadcrumbs"
      items={[{ label: "Início", href: url("/") }, { label: "Produtos", href: url("/produtos/") }, { label: category.data.title }]}
    />
  </PageHeader>
  <section class="section-y">
    <div class="container-page">
      <CatalogGrid products={products} label={category.data.title} />
    </div>
  </section>
</BaseLayout>
