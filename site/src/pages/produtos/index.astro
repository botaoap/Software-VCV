---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CatalogGrid from "../../components/CatalogGrid.astro";
import PageHeader from "../../components/PageHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProducts } from "../../lib/content";
import { url } from "../../lib/url";

const products = await getProducts();
---

<BaseLayout title="Produtos" description="Todos os produtos da VCV — Veste Com Você: vestidos, calças, blusas, saias, bermudas e mais, com envio para todo o Brasil.">
  <PageHeader eyebrow="Produtos" title="Todas as peças" lede="Escolha a cor e o tamanho; enviamos para todo o Brasil.">
    <Breadcrumbs slot="breadcrumbs" items={[{ label: "Início", href: url("/") }, { label: "Produtos" }]} />
  </PageHeader>
  <section class="section-y">
    <div class="container-page">
      {
        products.length === 0 ? (
          <p class="text-lg text-text-muted">Em breve novas peças.</p>
        ) : (
          <CatalogGrid products={products} label="Todas as peças" />
        )
      }
    </div>
  </section>
</BaseLayout>
