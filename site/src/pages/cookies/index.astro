---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PageHeader from "../../components/PageHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { url } from "../../lib/url";
---

<!-- PLACEHOLDER: the legal text must come from (or be approved by) the client. Not indexed until it does. -->
<BaseLayout title="Política de Cookies" description="Quais cookies e armazenamento local o site usa." noindex>
  <PageHeader eyebrow="Institucional" title="Política de Cookies">
    <Breadcrumbs slot="breadcrumbs" items={[{ label: "Início", href: url("/") }, { label: "Política de Cookies" }]} />
  </PageHeader>
  <section class="section-y">
    <div class="container-page">
      <div class="prose-vcv">
        <p>
          <strong>[PLACEHOLDER]</strong> O texto desta página será fornecido e aprovado pela VCV antes da publicação.
        </p>
        <p>
          Enquanto isso: o site guarda no seu navegador apenas a sua sacola de compras (armazenamento local, estritamente
          necessário). Nenhum outro dado pessoal é coletado enquanto o pagamento online não estiver disponível.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
