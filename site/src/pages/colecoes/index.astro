---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CollectionTile from "../../components/CollectionTile.astro";
import PageHeader from "../../components/PageHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollections, getProductsOf } from "../../lib/content";
import { url } from "../../lib/url";

const collections = await getCollections();
const tiles = await Promise.all(
  collections.map(async (collection) => ({ collection, count: (await getProductsOf(collection.id)).length })),
);
---

<BaseLayout title="Coleções" description="As coleções da VCV: peças feitas rolo a rolo no ateliê de Gaspar, Vale do Itajaí.">
  <PageHeader eyebrow="Coleções" title="Coleções" lede="Cada coleção reúne peças pensadas para combinar entre si.">
    <Breadcrumbs slot="breadcrumbs" items={[{ label: "Início", href: url("/") }, { label: "Coleções" }]} />
  </PageHeader>
  <section class="section-y">
    <div class="container-page">
      {
        tiles.length === 0 ? (
          <p class="text-lg text-text-muted">Em breve novas coleções.</p>
        ) : (
          <ul class="grid gap-6 md:grid-cols-2">
            {tiles.map(({ collection, count }, index) => <li class="reveal" style={`--reveal-delay:${index * 80}ms`}><CollectionTile collection={collection} count={count} heading="h2" /></li>)}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>
