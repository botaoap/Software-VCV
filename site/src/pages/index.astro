---
import ExternalLink from "../components/ExternalLink.astro";
import HeroCarousel from "../components/HeroCarousel.astro";
import Icon from "../components/Icon.astro";
import ProductCard from "../components/ProductCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import TrustStrip from "../components/TrustStrip.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getBrand, getProducts, getRails } from "../lib/content";
import { whatsappHref } from "../lib/format";
import { brand } from "../lib/site";
import { url } from "../lib/url";

const { about, contact } = await getBrand();
const rails = await getRails();
const all = await getProducts();
const intro = about.sections[0];

// Organization facts for search and AI answers: only what is true today. `sameAs` lists the official
// profiles once they exist (an entity's strongest GEO signal), never a placeholder.
const sameAs = [contact.instagram].filter(Boolean);
const siteUrl = Astro.site!.href;
const organization = {
  "@context": "https://schema.org",
  "@type": "ClothingStore",
  name: brand.name,
  alternateName: brand.short,
  description: brand.description,
  url: siteUrl,
  address: { "@type": "PostalAddress", addressLocality: "Gaspar", addressRegion: "SC", addressCountry: "BR" },
  areaServed: { "@type": "Country", name: "Brasil" },
  ...(sameAs.length > 0 && { sameAs }),
  ...(contact.email && { email: contact.email }),
};
---

<BaseLayout
  title="VCV — Veste Com Você | Roupas de Gaspar, SC, com envio para todo o Brasil"
  rawTitle
  description={brand.description}
  structuredData={[organization]}
>
  <HeroCarousel />
  <TrustStrip />

  {
    rails.map((rail, railIndex) => (
      <section class:list={["section-y", railIndex % 2 === 1 && "bg-paper"]} aria-labelledby={`rail-${rail.id}-title`} data-rail={rail.id}>
        <div class="container-page">
          <SectionHeading eyebrow={brand.tagline} title={rail.title} id={`rail-${rail.id}-title`}>
            {railIndex === 0 && (
              <a href={url("/produtos/")} class="link-arrow">Ver todos os {all.length} produtos <span class="arrow" aria-hidden="true">→</span></a>
            )}
          </SectionHeading>
          <ul class="mt-10 grid grid-cols-2 gap-x-4 gap-y-10 md:gap-x-6 lg:grid-cols-4">
            {rail.products.map((product, index) => <ProductCard product={product} index={index} class="reveal" />)}
          </ul>
        </div>
      </section>
    ))
  }

  {
    intro && (
      <section class="section-y" aria-labelledby="about-title">
        <div class="container-page max-w-3xl text-center">
          <p class="eyebrow">Sobre a VCV</p>
          <h2 id="about-title" class="mt-3 text-3xl md:text-4xl">{about.headline}</h2>
          <p class="mt-5 text-lg leading-relaxed text-text-muted">{intro.body}</p>
          <a href={url("/sobre/")} class="link-arrow mt-4">Conheça a VCV <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </section>
    )
  }

  {
    contact.whatsapp && (
      <section class="bg-wine section-y text-cream" aria-labelledby="contact-band-title">
        <div class="container-page flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
          <div class="max-w-xl">
            <p class="text-xs font-medium tracking-[0.28em] text-rose-soft uppercase">Atendimento</p>
            <h2 id="contact-band-title" class="mt-3 text-3xl text-cream md:text-4xl">Dúvida sobre tamanho ou tecido?</h2>
            <p class="mt-4 text-lg text-cream/80">Chame a VCV no WhatsApp.</p>
          </div>
          <ExternalLink href={whatsappHref(contact.whatsapp, "Olá! Vim pelo site da VCV e tenho uma dúvida.")} class="btn btn-light btn-lg">
            <Icon name="message" size={18} /> Falar no WhatsApp
          </ExternalLink>
        </div>
      </section>
    )
  }
</BaseLayout>
