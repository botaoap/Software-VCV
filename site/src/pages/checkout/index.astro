---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PageHeader from "../../components/PageHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { checkout } from "../../lib/commerce/checkout";
import { url } from "../../lib/url";

// The order summary, then the hand-off to the platform's hosted checkout (Nuvemshop + Mercado Pago:
// Pix, card, installments; no card data on this site). With no checkout-capable adapter the page
// says "Pagamento online em breve".
const canCheckout = checkout.capabilities.checkout;
---

<BaseLayout title="Finalizar pedido" description={canCheckout ? "Revise seu pedido e siga para o pagamento." : "O pagamento online da VCV estará disponível em breve."} noindex>
  <PageHeader eyebrow="Compra" title="Finalizar pedido">
    <Breadcrumbs
      slot="breadcrumbs"
      items={[{ label: "Início", href: url("/") }, { label: "Sacola", href: url("/carrinho/") }, { label: "Finalizar" }]}
    />
  </PageHeader>

  <section class="section-y">
    <div class="container-page max-w-3xl">
      {
        !canCheckout && (
          <div class="rounded-lg border border-border bg-paper p-6 md:p-8" role="status">
            <p class="eyebrow">Em breve</p>
            <h2 class="mt-3 text-3xl">Pagamento online em breve</h2>
            <p class="mt-4 text-lg leading-relaxed text-text-muted">
              Estamos finalizando a forma de pagamento da loja. Sua sacola fica salva neste navegador até lá.
            </p>
          </div>
        )
      }

      <div class="js-only mt-10" data-checkout>
        <div class="hidden" data-checkout-empty>
          <p class="text-xl text-text-muted">Sua sacola está vazia.</p>
          <a href={url("/produtos/")} class="btn btn-primary mt-6">Ver produtos</a>
        </div>

        <div class="hidden" data-checkout-summary>
          <h2 class="text-2xl">Seu pedido</h2>
          <ul class="mt-5 divide-y divide-border border-y border-border" data-checkout-lines></ul>
          <p class="mt-4 flex items-baseline justify-between">
            <span class="text-lg font-medium">Subtotal</span>
            <strong class="text-xl font-medium text-wine" data-checkout-subtotal></strong>
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            {canCheckout && (
              <button type="button" class="btn btn-primary btn-lg" data-checkout-pay>Ir para o pagamento</button>
            )}
            <a href={url("/carrinho/")} class="btn btn-outline btn-lg">Voltar à sacola</a>
            <a href={url("/produtos/")} class="link-arrow">Continuar comprando <span class="arrow" aria-hidden="true">→</span></a>
          </div>
          <p class="mt-4 text-sm text-text-muted" aria-live="polite" data-checkout-status></p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { checkout } from "../../lib/commerce/checkout";
  import { formatBrl } from "../../lib/format";
  import { itemCount, readCart, subtotalCents, variantLabel } from "../../scripts/cart";

  const root = document.querySelector<HTMLElement>("[data-checkout]");
  if (root) {
    const part = (name: string) => root.querySelector<HTMLElement>(`[data-checkout-${name}]`)!;
    const empty = part("empty");
    const summary = part("summary");
    const list = part("lines");
    const subtotal = part("subtotal");

    const lines = readCart();
    const isEmpty = itemCount(lines) === 0;
    empty.classList.toggle("hidden", !isEmpty);
    summary.classList.toggle("hidden", isEmpty);
    for (const line of lines) {
      const li = document.createElement("li");
      li.className = "flex items-baseline justify-between gap-4 py-3 text-sm";
      const text = document.createElement("span");
      text.textContent = `${line.name} · ${variantLabel(line)} · x${line.quantity}`;
      const price = document.createElement("span");
      price.className = "font-medium text-wine";
      price.textContent = formatBrl(line.unitPriceCents * line.quantity);
      li.append(text, price);
      list.append(li);
    }
    subtotal.textContent = formatBrl(subtotalCents(lines));

    // Hand the bag to the platform's checkout; a failure keeps the visitor here with a message.
    const pay = root.querySelector<HTMLButtonElement>("[data-checkout-pay]");
    const status = part("status");
    pay?.addEventListener("click", async () => {
      pay.disabled = true;
      status.textContent = "Abrindo o pagamento…";
      try {
        const start = await checkout.startCheckout(readCart());
        // Only ever leave for a secure checkout page; anything else is shown as a failure.
        if (start.kind === "redirect") {
          if (new URL(start.url).protocol !== "https:") throw new Error("checkout URL is not https");
          return location.assign(start.url);
        }
        status.textContent = start.reason;
      } catch {
        status.textContent = "Não foi possível abrir o pagamento agora. Tente de novo em instantes.";
      }
      pay.disabled = false;
    });
  }
</script>
