# Copy to site/.env (git-ignored) to build or run the site against the Nuvemshop store locally:
#   cp .env.example .env   then fill in the two values and run `npm run dev`.
# Leave PUBLIC_COMMERCE unset (or "static") for the built-in catalog in content/products.json.
# The token is a secret: never commit .env and never prefix these two with PUBLIC_.
PUBLIC_COMMERCE=nuvemshop
NUVEMSHOP_STORE_ID=
NUVEMSHOP_TOKEN=
